FLASK_SECRET_KEY='replace-with-a-long-random-secret'
FLUTU_GOOGLE_CLIENT_ID='your-google-oauth-client-id'
FLUTU_GOOGLE_CLIENT_SECRET='your-google-oauth-client-secret'
# Set this to the public HTTPS callback URL for the deployed application.
FLUTU_GOOGLE_REDIRECT_URI='http://127.0.0.1:8000/auth/google/callback'
FLASK_SESSION_COOKIE_SECURE='false'
MONGODB_URI='mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority'
MONGODB_DATABASE='flutu'
# Required for production Socket.IO broadcasts across app instances.
REDIS_URL='redis://localhost:6379/0'
# Optional comma-separated app origins; unset restricts Socket.IO to same-origin.
SOCKETIO_CORS_ORIGINS=''
APP_ENV='development'
SOCKETIO_REQUIRE_REDIS='true'
# Used only when the local runtime has no /etc/resolv.conf (e.g. some mobile IDEs).
MONGODB_DNS_NAMESERVERS='1.1.1.1,8.8.8.8'
