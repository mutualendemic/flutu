msgstr "Conversa ramificada"

msgid "Location map"
msgstr "Mapa de localização"

msgid "My profile"
msgstr "O meu perfil"

msgid "Friend notifications"
msgstr "Notificações de amigos"

msgid "Get notified about location-sharing requests, new conversation members, and questions from your conversations."
msgstr "Receba notificações sobre pedidos de partilha da localização, novos membros e perguntas nas suas conversas."

msgid "Enable notifications"
msgstr "Ativar notificações"

msgid "Checking this device…"
msgstr "A verificar este dispositivo…"

