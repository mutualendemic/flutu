FLASK_SECRET_KEY='replace-with-a-long-random-secret'
FLUTU_GOOGLE_CLIENT_ID='your-google-oauth-client-id'
FLUTU_GOOGLE_CLIENT_SECRET='your-google-oauth-client-secret'
# Set this to the public HTTPS callback URL for the deployed application.
FLUTU_GOOGLE_REDIRECT_URI='http://127.0.0.1:8000/auth/google/callback'
FLASK_SESSION_COOKIE_SECURE='false'
MONGODB_URI='mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority'
MONGODB_DATABASE='flutu'
# Create the API key in the IBM Quantum Platform dashboard; instance is optional.
IBM_QUANTUM_API_KEY='your-ibm-quantum-api-key'
IBM_QUANTUM_INSTANCE='your-ibm-quantum-instance-crn'
# Supabase Realtime is used for instant chat invalidation broadcasts.
SUPABASE_URL='https://<project-ref>.supabase.co'
SUPABASE_ANON_KEY='your-supabase-publishable-or-anon-key'
SUPABASE_SERVICE_ROLE_KEY='your-supabase-secret-or-service-role-key'
SUPABASE_JWT_SECRET='your-supabase-jwt-signing-secret'
# Use supabase for Supabase Broadcast, socketio for self-hosted Flask-SocketIO,
# or polling as a fallback when no realtime provider is configured.
CHAT_REALTIME_MODE='supabase'
# Required for production Socket.IO broadcasts across app instances.
REDIS_URL='redis://localhost:6379/0'
# Optional comma-separated app origins; unset restricts Socket.IO to same-origin.
SOCKETIO_CORS_ORIGINS=''
APP_ENV='development'
SOCKETIO_REQUIRE_REDIS='true'
# Used only when the local runtime has no /etc/resolv.conf (e.g. some mobile IDEs).
MONGODB_DNS_NAMESERVERS='1.1.1.1,8.8.8.8'
