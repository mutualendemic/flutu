FLASK_SECRET_KEY='replace-with-a-long-random-secret'
FLUTU_GOOGLE_CLIENT_ID='your-google-oauth-client-id'
FLUTU_GOOGLE_CLIENT_SECRET='your-google-oauth-client-secret'
# Override this in SnapDeploy with your public HTTPS domain + /auth/google/callback.
FLUTU_GOOGLE_REDIRECT_URI='http://127.0.0.1:8000/auth/google/callback'
FLASK_SESSION_COOKIE_SECURE='false'
MONGODB_URI='mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority'
MONGODB_DATABASE='flutu'
